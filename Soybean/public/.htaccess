<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # API reverse proxy path — handled by Apache/Nginx proxy, not SPA
  RewriteRule ^proxy-default - [L]

  RewriteRule ^index\.html$ - [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
