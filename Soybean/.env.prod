# backend service base url, prod environment
# Production: use same-origin proxy path (Apache/Nginx forwards /proxy-default -> backend).
# Do NOT use http://127.0.0.1:8000 here — browsers will call the visitor's localhost.
VITE_SERVICE_BASE_URL=/api

# Real backend address for Vite dev/preview proxy only (not baked into browser requests)
VITE_SERVICE_PROXY_TARGET=http://127.0.0.1:8787

# Use static routes + backend menus (NovaPHP); do not use soybean /route/* mock APIs
VITE_AUTH_ROUTE_MODE=static

# history mode requires server fallback to index.html (see public/.htaccess)
VITE_ROUTER_HISTORY_MODE=history

# other backend service base url, prod environment
VITE_OTHER_SERVICE_BASE_URL= `{
  "demo": "http://localhost:9529"
}`
